{
  "name": "webknot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "branding-check": "tsx scripts/branding-check.ts",
    "scan:secrets": "tsx scripts/scan-bundle-secrets.ts",
    "prebuild": "npm run branding-check",
    "build": "vite build",
    "postbuild": "npm run build:preview && npm run scan:secrets",
    "build:preview": "vite build --config preview-runtime/vite.config.ts",
    "preview:dev": "vite --config preview-runtime/vite.config.ts",
    "start": "npx serve -s dist -l 10000",
    "prelint": "npm run branding-check && npm run scan:secrets",
    "lint": "eslint src --quiet",
    "lint:legacy": "eslint .",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:integration": "vitest --run --config vitest.integration.config.ts",
    "test:legacy-ai": "vitest --run --config vitest.legacy-ai.config.ts",
    "test:performance": "vitest --run --config vitest.performance.config.ts",
    "test:smoke": "vitest --run --config vitest.smoke.config.ts",
    "test:ui": "vitest --ui",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-aspect-ratio": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-context-menu": "^2.2.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-hover-card": "^1.1.1",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-menubar": "^1.1.1",
    "@radix-ui/react-navigation-menu": "^1.2.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@stackblitz/sdk": "1.11.0",
    "@supabase/supabase-js": "2.108.2",
    "@tanstack/react-query": "^5.100.9",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "gl-matrix": "^3.4.4",
    "gsap": "^3.13.0",
    "jszip": "3.10.1",
    "lenis": "^1.3.23",
    "lucide-react": "^0.446.0",
    "mathjs": "^15.2.0",
    "motion": "^12.23.24",
    "next-themes": "^0.3.0",
    "ogl": "^1.0.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.6.0",
    "react-resizable-panels": "^2.1.3",
    "react-router-dom": "^7.9.1",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.180.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.7.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.0.6",
    "esbuild": "^0.28.0",
    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "fast-check": "^3.23.2",
    "globals": "^15.9.0",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "serve": "^14.2.5",
    "tailwindcss": "^4.2.4",
    "terser": "^5.44.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.7.0",
    "vite": "^8.0.12",
    "vite-plugin-compression2": "^2.3.1",
    "vitest": "^4.0.6"
  }
}
