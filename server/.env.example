# Server Configuration
PORT=3001
NODE_ENV=development

# Upstash Redis (REST API)
UPSTASH_REDIS_REST_URL=https://working-ostrich-32833.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# Neon Postgres
DATABASE_URL=postgresql://neondb_owner:password@host/neondb?sslmode=require

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Cache Configuration
CACHE_TTL=3600000
CACHE_MAX_SIZE=1000

# ============================================================
# AI Proxy Rate Limiting (Phase 3 — Req 3.6.1–3.6.4, design §1.3)
# ------------------------------------------------------------
# Quotas applied to every `/api/ai/*` route. Authenticated callers
# (valid Supabase bearer JWT) are bucketed per-user; everyone else
# is bucketed per-IP. The per-IP ceiling is clamped so it is NEVER
# more generous than the per-user ceiling (Req 3.6.2).
#
# The counter store is selected automatically: when the UPSTASH_*
# vars above are set, a Redis-backed fixed-window store is used
# (multi-instance safe); otherwise an in-memory store is used
# (single-instance dev / tests). No call-site changes are needed.
# ============================================================

# Max AI requests per authenticated user, per window (default 60).
AI_RATE_LIMIT_PER_USER=60

# Max AI requests per client IP, per window (default 30). Clamped to <= per-user.
AI_RATE_LIMIT_PER_IP=30

# Fixed-window length in milliseconds (default 60000 = 1 minute).
AI_RATE_LIMIT_WINDOW_MS=60000

# ============================================================
# GitHub App (Phase 2 GitHub export) — SERVER-ONLY SECRETS
# ------------------------------------------------------------
# These power the GitHub_App export flow (POST /api/github/*).
# Installation tokens are minted server-side from the private key
# per request and are NEVER returned to the client.
#
# SECURITY (Req 2.5.1, 2.5.5, C.4.1):
#   - NEVER mirror any of these into a `VITE_*` variable.
#   - NEVER ship these to the client bundle.
#   - The GitHub App must be registered with these permissions:
#       contents: write       (commit Starter files)
#       metadata: read        (read account/repo metadata)
#       administration: write (create the repository)
# ============================================================

# Numeric App ID from the GitHub App settings page.
GITHUB_APP_ID=

# App private key (PEM). For multi-line PEM in a single env var,
# replace newlines with \n or wrap the value in quotes.
GITHUB_APP_PRIVATE_KEY=

# Secret used to verify incoming GitHub App webhook signatures.
GITHUB_APP_WEBHOOK_SECRET=

# App "slug" used to build the installation URL:
#   https://github.com/apps/<GITHUB_APP_SLUG>/installations/new
GITHUB_APP_SLUG=

# OAuth client id of the GitHub App (used by the install flow).
GITHUB_APP_CLIENT_ID=
